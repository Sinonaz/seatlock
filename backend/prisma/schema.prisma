generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum BookingStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentStatus {
  PENDING // сессия Checkout создана, ждём оплату
  SUCCEEDED // пришёл checkout.session.completed
  FAILED // сессия истекла / отменена
  REFUNDED // деньги вернули
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events        Event[]
  bookings      Booking[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique // sha256 от токена; сам токен не храним
  familyId  String // общая цепочка ротаций одного входа
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Event {
  id             String      @id @default(uuid())
  organizerId    String
  title          String
  description    String      @default("")
  venue          String
  city           String
  startsAt       DateTime
  priceCents     Int
  currency       String      @default("usd")
  capacity       Int
  availableSeats Int // денормализованный счётчик; меняется только атомарно
  coverImageUrl  String?
  status         EventStatus @default(DRAFT)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organizer User      @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  bookings  Booking[]

  @@index([status, startsAt]) // каталог: WHERE status = 'PUBLISHED' AND startsAt > now() ORDER BY startsAt
  @@index([organizerId])
  @@map("events")
}

model Booking {
  id             String        @id @default(uuid())
  userId         String
  eventId        String
  status         BookingStatus @default(PENDING)
  quantity       Int
  unitPriceCents Int // цена фиксируется в момент брони
  totalCents     Int
  currency       String
  expiresAt      DateTime
  paidAt         DateTime?
  cancelledAt    DateTime?
  ticketCode     String?       @unique
  idempotencyKey String
  requestHash    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  event    Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@unique([userId, idempotencyKey]) // ← сердце идемпотентности
  @@index([userId, createdAt])
  @@index([eventId, status])
  @@index([status, expiresAt]) // для задачи истечения
  @@map("bookings")
}

model Payment {
  id                      String        @id @default(uuid())
  bookingId               String
  stripeCheckoutSessionId String?       @unique
  checkoutRequest         Json?
  refundRequested         Boolean       @default(false)
  stripePaymentIntentId   String?       @unique
  amountCents             Int
  currency                String
  status                  PaymentStatus @default(PENDING)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([refundRequested, status])
  @@map("payments")
}

// Журнал обработанных вебхуков: id события Stripe (evt_...) как первичный ключ
model ProcessedWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("processed_webhook_events")
}
