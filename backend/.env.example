NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/seatlock_db?schema=public"
FRONTEND_URL=http://localhost:5173

JWT_ACCESS_SECRET=dev_access_secret_change_me_to_64_random_chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

BOOKING_TTL_MINUTES=15
REFUND_WINDOW_HOURS=24

# --- Stripe (test mode) ---
# Set STRIPE_ENABLED=true once the keys below are filled in, otherwise paid
# checkouts return 503 and only free bookings work. Never commit real keys.
# STRIPE_SECRET_KEY: Stripe Dashboard -> Developers -> API keys -> sk_test_...
# STRIPE_WEBHOOK_SECRET: from `stripe listen --forward-to localhost:3000/api/payments/webhook`
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
